# Copy this file to .env, then replace every placeholder locally.
# Never publish .env, paste its contents into screenshots, or commit it to Git.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/ai_platform?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_BYTE_SECRET
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY

# auto: Secure is enabled when the request arrives through HTTPS.
# Keep auto for a site that supports both classroom HTTP and public HTTPS.
COOKIE_SECURE=auto

# Comma-separated development origins only. Same-origin production access needs no entry.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
